# Copy to infra/.env and replace every CHANGE_ME value before the first startup.
POSTGRES_DB=tk_mg
POSTGRES_USER=tk_mg
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PASSWORD_URL_ENCODED=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PASSWORD_URL_ENCODED=CHANGE_ME_REDIS_PASSWORD
# Keep service passwords raw. Put their percent-encoded forms in the *_URL_ENCODED variables.
# Exactly 32 UTF-8 bytes. The sample has the required length but is never safe for deployment.
SECRET_ENCRYPTION_KEY=01234567890123456789012345678901
# Docker includes the pinned proxy probe core. For direct Bun startup, install this binary.
# Legacy connectivity-transport diagnostics only; /detect now queries IP information directly.
PROXY_PROBE_BINARY=/usr/local/bin/sing-box
# Manually create this UUID as an existing disabled administrator in app_user before API /ready or worker startup.
# Use the same dedicated actor for API and worker; never use a requester or the login administrator.
TK_MG_SYSTEM_ACTOR_ID=99999999-9999-4999-8999-999999999999
TK_MG_WORKER_ID=worker-1
TK_MG_WORKER_CONCURRENCY=4
TK_MG_WORKER_POLL_INTERVAL_MS=1000
TK_MG_WORKER_OUTBOX_BATCH_SIZE=20
TK_MG_WORKER_RECOVERY_BATCH_SIZE=20
TK_MG_WORKER_LEASE_MS=30000
TK_MG_WORKER_HEARTBEAT_MS=10000
TK_MG_WORKER_RETRY_DELAY_MS=1000
# Publish only on loopback until an internal TLS reverse proxy is configured.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Used only by the documented, one-time administrator bootstrap procedure.
ADMIN_BOOTSTRAP_EMAIL=admin@example.internal
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Pending real integration inputs. Do not mark storage as configured until supplied.
NAS_PROTOCOL=
NAS_HOST=
NAS_SHARE_OR_BUCKET=
NAS_USERNAME=
NAS_PASSWORD=

# Optional read-only initializer bridge, enabled with --profile initializer.
# Must point to a separate database using a SELECT-only role.
INIT_SOURCE_DATABASE_URL=
INIT_SOURCE_KEY=default
INIT_SYNC_INTERVAL_MS=5000
