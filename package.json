{
  "name": "tk-mg-sys",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build:web": "pnpm --filter @tk-mg/web build",
    "lint": "biome check .",
    "test": "pnpm --recursive run test",
    "test:e2e:smoke": "pnpm --dir apps/web exec playwright test e2e/auth.spec.ts e2e/devices.spec.ts",
    "test:postgres": "pnpm --filter @tk-mg/api test:postgres",
    "test:postgres:local": "powershell -ExecutionPolicy Bypass -File infra/scripts/test-postgres.ps1",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
